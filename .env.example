# ------------------------------------------------------------
# 환경설정 예시 파일 (이 파일은 GitHub에 올라가도 안전합니다)
#
# 사용법: 이 파일을 복사해 ".env" 라는 이름으로 저장한 뒤 값을 채우세요.
#        ".env" 파일은 .gitignore 에 의해 GitHub에 올라가지 않습니다.
# GitHub Actions 에서는 .env 대신 저장소 Settings > Secrets 에 등록합니다.
# ------------------------------------------------------------

# 공공데이터포털(data.go.kr)에서 발급받은 일반 인증키(Decoding 키 권장)
# ※ 실제 키를 이 예시 파일에 적지 마세요!
G2B_SERVICE_KEY=

# PG 관련 공고 선별에 사용할 키워드 (쉼표로 구분)
PG_KEYWORDS=PG,전자지급결제대행,지급결제대행,결제대행,전자결제,간편결제

# 수집 데이터 저장 폴더
DATA_DIR=data

# 로그 수준 (DEBUG, INFO, WARNING, ERROR)
LOG_LEVEL=INFO
